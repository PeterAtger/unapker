<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/sun</item>
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">@font/onest</item>
    </style>

    <style name="Text">
        <item name="android:fontFamily">@font/onest</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Text.Soft">
        <item name="android:textColor">@color/soft</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Text.Display">
        <item name="android:fontFamily">@font/dela_gothic_one</item>
        <item name="android:textSize">42sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.Tile">
        <item name="android:fontFamily">@font/dela_gothic_one</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">24sp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Button.Sun" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">66dp</item>
        <item name="android:background">@drawable/button_sun</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/onest</item>
        <item name="android:fontVariationSettings">"'wght' 700"</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Button.Ghost" parent="Button.Sun">
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/button_ghost</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontVariationSettings">"'wght' 600"</item>
        <item name="android:paddingBottom">0dp</item>
    </style>
</resources>
